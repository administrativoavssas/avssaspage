<!-- =====================================================================
     BANNER DE CONSENTIMIENTO DE COOKIES (2 CAPAS) - AVSSAS (LEY 1581)
     ===================================================================== -->
<style>
  :root {
    --avs-primary: #0f3d5e;      /* Azul corporativo industrial */
    --avs-primary-hover: #0a2a42;
    --avs-accent: #e67e22;       /* Acento seguridad industrial */
    --avs-bg: #ffffff;
    --avs-text: #1f2937;
    --avs-muted: #4b5563;
    --avs-border: #d1d5db;
    --avs-shadow: 0 -4px 20px rgba(0, 0, 0, 0.12);
  }

  /* Capa 1: Banner Inferior */
  #avs-cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--avs-bg);
    color: var(--avs-text);
    border-top: 3px solid var(--avs-primary);
    box-shadow: var(--avs-shadow);
    padding: 20px 24px;
    z-index: 99998;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: none; /* Se activa por JS si no hay consentimiento previo */
  }

  .avs-banner-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .avs-banner-text {
    flex: 1 1 600px;
    font-size: 14px;
    line-height: 1.5;
  }

  .avs-banner-text h4 {
    margin: 0 0 6px 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--avs-primary);
  }

  .avs-banner-text p {
    margin: 0;
    color: var(--avs-muted);
  }

  .avs-banner-text a {
    color: var(--avs-primary);
    text-decoration: underline;
    font-weight: 600;
  }

  /* Botones con igualdad de jerarquía visual (Sin dark patterns) */
  .avs-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .avs-btn {
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1.5px solid var(--avs-primary);
    text-align: center;
  }

  .avs-btn-primary {
    background-color: var(--avs-primary);
    color: #ffffff;
  }

  .avs-btn-primary:hover {
    background-color: var(--avs-primary-hover);
  }

  .avs-btn-outline {
    background-color: #ffffff;
    color: var(--avs-primary);
  }

  .avs-btn-outline:hover {
    background-color: #f3f4f6;
  }

  /* Capa 2: Modal de Configuración */
  #avs-cookie-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.55);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .avs-modal {
    background-color: var(--avs-bg);
    max-width: 620px;
    width: 100%;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .avs-modal-header {
    padding: 18px 24px;
    background-color: var(--avs-primary);
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .avs-modal-header h3 {
    margin: 0;
    font-size: 18px;
  }

  .avs-modal-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
  }

  .avs-modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    font-size: 14px;
    color: var(--avs-muted);
  }

  .avs-cookie-category {
    border: 1px solid var(--avs-border);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 14px;
  }

  .avs-category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .avs-category-title {
    font-weight: 700;
    color: var(--avs-text);
    font-size: 15px;
  }

  .avs-badge-required {
    font-size: 12px;
    background-color: #e5e7eb;
    color: #374151;
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  /* Interruptor Toggle */
  .avs-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }

  .avs-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .avs-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #cbd5e1;
    transition: 0.3s;
    border-radius: 24px;
  }

  .avs-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .avs-slider {
    background-color: var(--avs-primary);
  }

  input:checked + .avs-slider:before {
    transform: translateX(20px);
  }

  .avs-modal-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--avs-border);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    background-color: #f9fafb;
  }

  @media (max-width: 640px) {
    .avs-banner-actions, .avs-modal-footer {
      flex-direction: column;
      width: 100%;
    }
    .avs-btn {
      width: 100%;
    }
  }
</style>

<!-- CAPA 1: BANNER PRINCIPAL -->
<div id="avs-cookie-banner" role="region" aria-label="Aviso de cookies">
  <div class="avs-banner-container">
    <div class="avs-banner-text">
      <h4>Uso de cookies y privacidad en nuestro sitio web</h4>
      <p>
        En <strong>ALTAS VERIFICACIONES EN SEGURIDAD A.V.S. S.A.S.</strong> utilizamos cookies propias y de terceros para garantizar el funcionamiento técnico del sitio, analizar el tráfico de visitas y mejorar nuestros servicios de inspección y pruebas de hermeticidad. Puede aceptar todas las cookies, rechazar las no esenciales o configurar sus preferencias. Consulte nuestra 
        <a href="/politica-cookies" target="_blank">Política de Cookies</a> y nuestra 
        <a href="#privacidad">Política de Tratamiento de Datos Personales</a>.
      </p>
    </div>
    <div class="avs-banner-actions">
      <button type="button" class="avs-btn avs-btn-primary" onclick="AVSCookies.acceptAll()">Aceptar todas</button>
      <button type="button" class="avs-btn avs-btn-outline" onclick="AVSCookies.rejectNonEssential()">Rechazar no esenciales</button>
      <button type="button" class="avs-btn avs-btn-outline" onclick="AVSCookies.openModal()">Configurar preferencias</button>
    </div>
  </div>
</div>

<!-- CAPA 2: MODAL DE CONFIGURACIÓN -->
<div id="avs-cookie-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="avs-modal-title">
  <div class="avs-modal">
    <div class="avs-modal-header">
      <h3 id="avs-modal-title">Configuración de Preferencias de Cookies</h3>
      <button type="button" class="avs-modal-close" aria-label="Cerrar" onclick="AVSCookies.closeModal()">&times;</button>
    </div>
    <div class="avs-modal-body">
      <p style="margin-top: 0;">
        Seleccione qué categorías de cookies autoriza instalar en su navegador. Las cookies estrictamente necesarias no pueden desactivarse, ya que garantizan la seguridad y navegabilidad básica de la plataforma.
      </p>

      <!-- Categoría 1: Necesarias -->
      <div class="avs-cookie-category">
        <div class="avs-category-header">
          <span class="avs-category-title">1. Cookies Técnicas o Estrictamente Necesarias</span>
          <span class="avs-badge-required">Siempre activas</span>
        </div>
        <p style="margin: 0; font-size: 13px;">
          Indispensables para el funcionamiento del sitio web, la seguridad de los formularios de cotización y la carga de la página. No almacenan información personal identificable.
        </p>
      </div>

      <!-- Categoría 2: Analíticas -->
      <div class="avs-cookie-category">
        <div class="avs-category-header">
          <span class="avs-category-title">2. Cookies de Análisis y Rendimiento</span>
          <label class="avs-switch">
            <input type="checkbox" id="avs-consent-analytics">
            <span class="avs-slider"></span>
          </label>
        </div>
        <p style="margin: 0; font-size: 13px;">
          Nos permiten contar las visitas y fuentes de tráfico (ej. Google Analytics) para medir qué servicios técnicos (inspección EDS, hermeticidad o pruebas hidrostáticas) son más consultados.
        </p>
      </div>

      <!-- Categoría 3: Terceros -->
      <div class="avs-cookie-category">
        <div class="avs-category-header">
          <span class="avs-category-title">3. Cookies de Terceros y Funcionalidad Externa</span>
          <label class="avs-switch">
            <input type="checkbox" id="avs-consent-thirdparty">
            <span class="avs-slider"></span>
          </label>
        </div>
        <p style="margin: 0; font-size: 13px;">
          Permiten la integración con herramientas externas como canales de atención en WhatsApp, mapas de ubicación o verificación de acreditaciones ONAC.
        </p>
      </div>
    </div>
    <div class="avs-modal-footer">
      <button type="button" class="avs-btn avs-btn-outline" onclick="AVSCookies.savePreferences()">Guardar mis preferencias</button>
      <button type="button" class="avs-btn avs-btn-primary" onclick="AVSCookies.acceptAll()">Aceptar todas</button>
    </div>
  </div>
</div>

<script>
  const AVSCookies = (function () {
    const STORAGE_KEY = 'avssas_cookie_consent_v1';

    // Genera un ID único de auditoría para respaldo ante la SIC
    function generateConsentId() {
      return 'AVS-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).substring(2, 7).toUpperCase();
    }

    // Ejecuta los scripts según lo autorizado (BLOQUEO PREVIO)
    function applyScripts(preferences) {
      if (preferences.analytics) {
        console.log('[AVSSAS] Cookies de Análisis activadas.');
        // INSERTAR AQUÍ SCRIPT DE GOOGLE ANALYTICS / TAG MANAGER
        // Ejemplo:
        // const script = document.createElement('script');
        // script.src = 'https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX';
        // script.async = true;
        // document.head.appendChild(script);
      }

      if (preferences.thirdParty) {
        console.log('[AVSSAS] Cookies de Terceros activadas.');
        // INSERTAR AQUÍ SCRIPTS DE TERCEROS (Mapas, widgets externos, píxeles)
      }
    }

    function saveRecord(analytics, thirdParty) {
      const record = {
        consentId: generateConsentId(),
        timestamp: new Date().toISOString(),
        preferences: {
          necessary: true,
          analytics: Boolean(analytics),
          thirdParty: Boolean(thirdParty)
        }
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
      document.getElementById('avs-cookie-banner').style.display = 'none';
      document.getElementById('avs-cookie-modal-overlay').style.display = 'none';
      applyScripts(record.preferences);
    }

    function init() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) {
        document.getElementById('avs-cookie-banner').style.display = 'block';
      } else {
        try {
          const parsed = JSON.parse(saved);
          document.getElementById('avs-consent-analytics').checked = parsed.preferences.analytics;
          document.getElementById('avs-consent-thirdparty').checked = parsed.preferences.thirdParty;
          applyScripts(parsed.preferences);
        } catch (e) {
          document.getElementById('avs-cookie-banner').style.display = 'block';
        }
      }
    }

    return {
      init: init,
      acceptAll: function () {
        saveRecord(true, true);
      },
      rejectNonEssential: function () {
        saveRecord(false, false);
      },
      savePreferences: function () {
        const analytics = document.getElementById('avs-consent-analytics').checked;
        const thirdParty = document.getElementById('avs-consent-thirdparty').checked;
        saveRecord(analytics, thirdParty);
      },
      openModal: function () {
        document.getElementById('avs-cookie-modal-overlay').style.display = 'flex';
      },
      closeModal: function () {
        document.getElementById('avs-cookie-modal-overlay').style.display = 'none';
      }
    };
  })();

  document.addEventListener('DOMContentLoaded', AVSCookies.init);
</script>
